# Test environment – uses a separate DB and Redis DB index
NODE_ENV=test
PORT=3001

DATABASE_URL="postgresql://menuadmin:supersecretpassword@localhost:5432/menu_digital_test?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redissecret
REDIS_DB=1

JWT_SECRET=test-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASSWORD_EXPIRY_MINUTES=60

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=menu-digital-test
S3_ENDPOINT=http://localhost:9000

CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000
