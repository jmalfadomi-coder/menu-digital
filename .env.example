# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60       # seconds
RATE_LIMIT_MAX=100      # requests per TTL window

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_USER=menuadmin
DB_PASSWORD=supersecretpassword
DB_NAME=menu_digital
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redissecret
REDIS_DB=0
REDIS_TTL=300           # seconds – default cache TTL

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASSWORD_EXPIRY_MINUTES=60

# ─── S3 / Object Storage ──────────────────────────────────────────────────────
# For local dev with MinIO:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=menu-digital
S3_CDN_URL=                  # Optional: CDN base URL (e.g. https://cdn.example.com)
S3_MAX_FILE_SIZE_MB=10

# ─── Email (future integration) ───────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=email-password
# FROM_EMAIL=noreply@menu.example.com
